NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=coches_db
DB_USER=coches_user
DB_PASSWORD=coches_password_dev

# Scraper
SCRAPER_TIMEOUT_MS=10000
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_DELAY_MIN_MS=500
SCRAPER_DELAY_MAX_MS=1000
SCRAPER_SECTION_ID=2500

# API
API_BASE_URL=https://vehicle-specs.coches.net

# Logging
LOG_LEVEL=info
