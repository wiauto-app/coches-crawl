DB_HOST=localhost
DB_PORT=5432
DB_NAME=coches_db
DB_USER=coches_user
DB_PASSWORD=coches_password_dev

DATABASE_URL=postgresql+psycopg2://coches_user:coches_password_dev@localhost:5432/coches_db

# Scrapy / rate limit
DOWNLOAD_DELAY=3
RANDOMIZE_DOWNLOAD_DELAY=true
CONCURRENT_REQUESTS=4
CONCURRENT_REQUESTS_PER_DOMAIN=2

# Listado
LIST_START_PAGE=1
LIST_MAX_PAGES=0
# 0 = todas las páginas (~6152)

# Detalle
DETAILS_BATCH_SIZE=100
DETAILS_MAX_ITEMS=0
# 0 = sin límite

# Playwright solo como fallback (por defecto desactivado: el WAF lo bloquea)
USE_PLAYWRIGHT=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROFILE_PATH=./playwright-profile

MONITOR_HOST=0.0.0.0
MONITOR_PORT=8001

# Si el WAF bloquea /fichas_tecnicas (405), usa proxy residencial o VPN:
# COCHES_HTTP_PROXY=http://user:pass@host:port
# COCHES_IMPERSONATE=chrome131
